# Copy to .env for local runs (.env is git-ignored). On Railway, set these in the service's Variables tab.
# Every value below is a placeholder. Never commit real values.

# ---- Required ----
# Shopify Dev Dashboard -> your app -> Settings. The API key (client ID) is public; the secret is not.
SHOPIFY_API_KEY=your-shopify-client-id
SHOPIFY_API_SECRET=your-shopify-client-secret
# Public HTTPS URL of this server (no trailing slash)
APP_URL=https://your-app.up.railway.app
# Postgres connection string. On Railway use the reference ${{Postgres.DATABASE_URL}}.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE
# 64 hex characters. Generate: openssl rand -hex 32
# NEVER change it after launch: courier keys and Shopify tokens saved with it become unreadable.
ENCRYPTION_KEY=replace-with-64-hex-characters

# ---- Courier webhooks ----
# The value Pathao's merchant API docs ask a webhook endpoint to return when the webhook is saved
# in the Pathao panel (header X-Pathao-Merchant-Webhook-Integration-Secret). Copy it from Pathao's docs.
PATHAO_WEBHOOK_INTEGRATION_SECRET=value-from-pathao-merchant-docs

# ---- Optional ----
SHOPIFY_API_VERSION=2026-10
SHOPIFY_APP_HANDLE=pathao-shipbridge
# Keep true until Shopify approves the app (test charges are free). Set false at launch.
BILLING_TEST=true
# Password for the owner page /admin (leave empty to switch the page off)
ADMIN_PASSWORD=choose-a-long-random-password
# Support contact shown in the privacy policy and plans
SUPPORT_EMAIL=
SUPPORT_WHATSAPP=+60XXXXXXXXX
# Dashboard API requests allowed per store per minute
API_RATE_PER_MINUTE=300
# SMS confirmations (coming soon)
SMS_FEATURE=false
# SSL_API_URL=https://smsplus.sslwireless.com/api/v3/send-sms/dynamic
