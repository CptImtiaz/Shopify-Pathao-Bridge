# Copy to .env for local runs. On Railway, set these in the service's Variables tab.

# From Shopify Dev Dashboard -> your app -> Settings
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_API_VERSION=2026-10
# The handle of your app (apps.shopify.com/<handle>, also visible in the admin URL of the app)
SHOPIFY_APP_HANDLE=pathao-shipbridge

# Public HTTPS URL of this server (no trailing slash)
APP_URL=https://your-app.up.railway.app

# Railway's Postgres plugin provides this automatically
DATABASE_URL=postgres://user:pass@host:5432/db

# 64 hex chars. Generate: openssl rand -hex 32   (NEVER change it after launch: stored secrets become unreadable)
ENCRYPTION_KEY=

# Keep true until Shopify approves the app (test charges are free). Set false at launch.
BILLING_TEST=true

# Optional overrides
# PATHAO_BASE_URL=https://api-hermes.pathao.com
# PATHAO_SANDBOX_URL=https://courier-api-sandbox.pathao.com
# PATHAO_WEBHOOK_INTEGRATION_SECRET=f3992ecc-59da-4cbe-a049-a13da2018d51
